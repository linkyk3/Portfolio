{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://linky2001.com",
          "http://localhost:3000"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "Content-Range",
        "Accept-Ranges",
        "Content-Length"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}